<comment>
problem = Symmetric Implosion Problem 4.7 Kiska and Wendroff (2003)

<job>
problem_id = symmetric_implosion

<parthenon/mesh>
refinement = none
nghost = 3

nx1 = 512
x1min = 0.0
x1max = 0.3
ix1_bc = reflecting
ox1_bc = reflecting

nx2 = 512
x2min = 0.0
x2max = 0.3
ix2_bc = reflecting
ox2_bc = reflecting

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 64
nx2 = 64
nx3 = 1

<parthenon/time>
integrator = rk3
cfl = 0.1
tlim = 2.5
nlim = -1
perf_cycle_offset = 2 # number of inital cycles not to be included in perf calc

<hydro>
fluid = euler
eos = adiabatic
reconstruction = weno3
gamma = 1.4

<parthenon/output0>
file_type = hdf5
dt = 0.1
variables = prim
id = prim

<parthenon/output1>
file_type  = hst        # History data dump
dt         = -0.1       # time increment between outputs
id = prim

<parthenon/output2>
file_type  = rst        # Binary data dump
dt         = -1.0       # time increment between outputs
id         = restart
