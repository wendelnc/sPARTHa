<comment>
problem   = Taylor-Green Vortex
reference = Taylor, G. I. and Green, A. E., Mechanism of the Production of Small Eddies from Large Ones, Proc. R. Soc. Lond. A, 158, 499–521 (1937).
configure = --prob=taylor_green

<job>
problem_id   = taylorgreen  # problem ID: basename of output filenames

<problem/taylorgreen>
M0 = 0.10
rho0 = 1.0
p0 = 1.0
b0 = 0.10

<parthenon/output1>
file_type  = hst        # History data dump
dt         = 0.01       # time increment between outputs
id = prim

<parthenon/output2>
file_type  = hdf5       # Binary data dump
variables  = prim       # variables to be output
dt         = 0.1        # time increment between outputs
id = prim

<parthenon/time>
cfl         = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim        = -1        # cycle limit
tlim        = 10.0       # time limit: 20tc where tc is L/V0
integrator  = rk3       # time integration algorithm
ncycle_out_mesh = -500  # print mesh structure every 500 cyles and on refinement

<parthenon/mesh>
nghost     = 2 

nx1        = 64        # Number of zones in X1-direction
x1min      = -0.5      # minimum value of X1
x1max      = 0.5       # maximum value of X1
ix1_bc     = periodic  # inner-X1 boundary flag
ox1_bc     = periodic  # outer-X1 boundary flag

nx2        = 64        # Number of zones in X2-direction
x2min      = -0.5      # minimum value of X2
x2max      = 0.5       # maximum value of X2
ix2_bc     = periodic  # inner-X2 boundary flag
ox2_bc     = periodic  # outer-X2 boundary flag

nx3        = 64        # Number of zones in X3-direction
x3min      = -0.5      # minimum value of X3
x3max      = 0.5       # maximum value of X3
ix3_bc     = periodic  # inner-X3 boundary flag
ox3_bc     = periodic  # outer-X3 boundary flag

pack_size = -1          # pack all blocks in a single pack (currently required)

<parthenon/meshblock>
nx1 = 64
nx2 = 64
nx3 = 64

<hydro>
fluid = mhd
eos = adiabatic
reconstruction = weno3
gamma           = 1.666666666666667         # gamma = C_p/C_v


